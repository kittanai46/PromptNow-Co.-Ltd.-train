<UserControl x:Class="Window_Event_Log.LogLevelSelectionControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#FFFFFFFF">
    <Viewbox>
        <Grid Height="1440" Width="1080">
            <!-- Background -->
            <Grid.Background>
                <ImageBrush ImageSource="pack://application:,,,/Window_Event_Log;component/Assets/Wallpaper.png" Stretch="UniformToFill" />
            </Grid.Background>

            <!-- Date and Time -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="40,75,0,0">
                <TextBlock x:Name="DateText" FontSize="20" FontWeight="Bold" Foreground="#CACACA" FontFamily="Roboto" />
                <TextBlock Text=" " FontSize="20" Width="45" />
                <TextBlock x:Name="TimeText" FontSize="20" FontWeight="Medium" Foreground="#CACACA" FontFamily="Noto Sans" Margin="0,-5,0,0"/>
            </StackPanel>

            <!-- Version Information -->
            <StackPanel HorizontalAlignment="Right" >
                <TextBlock Text="Launcher Version : 1.2.26.1333" 
                   FontSize="20" 
                   FontWeight="Medium" 
                   Foreground="#CACACA" 
                   FontFamily="Noto Sans" 
                   HorizontalAlignment="Right"
                   Margin="0,40,30,0"/>
                <TextBlock Text="PromptConnect : 1.2.10.240" 
                   FontSize="20" 
                   FontWeight="Medium" 
                   Foreground="#CACACA" 
                   FontFamily="Noto Sans" 
                   HorizontalAlignment="Right"
                   Margin="0,0,30,0"/>
                <TextBlock Text="MAC Address : 12as1234dfg1" 
                    FontSize="20" 
                    FontWeight="Medium" 
                    Foreground="#CACACA" 
                    FontFamily="Noto Sans" 
                    HorizontalAlignment="Right"
                    Margin="0,0,30,0"/>
            </StackPanel>



            <!-- Title -->
            <TextBlock Text="Windows Event Log Exporter"
               FontSize="36"
               FontFamily="Noto Sans"
               Foreground="#CACACA"
               HorizontalAlignment="Center"
               Margin="0,200,0,0"/>
            <!-- Status texts -->
            <TextBlock x:Name="LogTypeText"
                Text="Selected Log: "
                Foreground="White"
                HorizontalAlignment="Center"
                Margin="0,240,0,0"
                FontSize="45"
                FontWeight="Bold"
                FontFamily="Noto Sans" />

            <!-- Level Selection Buttons -->
            <Grid HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,300,0,0">
                <Image Source="pack://application:,,,/Window_Event_Log;component/Assets/Background_Level.png"
                    Width="960" Height="500" />

                <!-- Critical Level -->
                <Border x:Name="CriticalBorder" BorderBrush="Transparent" BorderThickness="2" Width="280" Height="200" Margin="50,45,0,0" HorizontalAlignment="Left" VerticalAlignment="Top">
                    <Button Click="CriticalCheckBox_Click">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Image Source="pack://application:,,,/Window_Event_Log;component/Assets/Event_Critical.png" Stretch="Uniform" />
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </Border>

                <!-- Error Level -->
                <Border x:Name="ErrorBorder" BorderBrush="Transparent" BorderThickness="2" Width="280" Height="200" Margin="0,45,0,0" HorizontalAlignment="Center" VerticalAlignment="Top">
                    <Button Click="ErrorCheckBox_Click">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Image Source="pack://application:,,,/Window_Event_Log;component/Assets/Event_Error.png" Stretch="Uniform" />
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </Border>

                <!-- Warning Level -->
                <Border x:Name="WarningBorder" BorderBrush="Transparent" BorderThickness="2" Width="280" Height="200" Margin="0,45,50,0" HorizontalAlignment="Right" VerticalAlignment="Top">
                    <Button Click="WarningCheckBox_Click">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Image Source="pack://application:,,,/Window_Event_Log;component/Assets/Event_Warning.png" Stretch="Uniform" />
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </Border>

                <!-- Information Level -->
                <Border x:Name="InformationBorder" BorderBrush="Transparent" BorderThickness="2" Width="280" Height="200" Margin="50,250,0,0" HorizontalAlignment="Left" VerticalAlignment="Top">
                    <Button Click="InformationCheckBox_Click">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Image Source="pack://application:,,,/Window_Event_Log;component/Assets/Event_Information.png" Stretch="Uniform" />
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </Border>

                <!-- Verbose Level -->
                <Border x:Name="VerboseBorder" BorderBrush="Transparent" BorderThickness="2" Width="280" Height="200" Margin="0,250,0,0" HorizontalAlignment="Center" VerticalAlignment="Top">
                    <Button Click="VerboseCheckBox_Click">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Image Source="pack://application:,,,/Window_Event_Log;component/Assets/Event_Verbose.png" Stretch="Uniform" />
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </Border>

                <!-- Void Placeholder -->
                <Border x:Name="Void" BorderBrush="Transparent" BorderThickness="2" Width="280" Height="200" Margin="0,250,50,0" HorizontalAlignment="Right" VerticalAlignment="Top">
                    <Image Source="pack://application:,,,/Window_Event_Log;component/Assets/Event_Void.png" Stretch="Uniform" />
                </Border>
            </Grid>

            <!-- Path Section -->
            <Grid HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,210,0,0">
                <Image Source="pack://application:,,,/Window_Event_Log;component/Assets/Background_PathDowload.png"
                    Width="960" Height="102" />

                <TextBlock x:Name="PathTextBlock"
                    Text="Export Path: PLEASE SELECT YOUR PATH"
                    FontSize="30"
                    Width="700"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Margin="0,0,0,0"
                    Foreground="White"
                    FontWeight="Bold" 
                    FontFamily="Noto Sans"
                    TextWrapping="Wrap"
                    TextTrimming="CharacterEllipsis" />

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,170,0,0">
                    <TextBlock Text="STATUS: " 
                        FontSize="40" 
                        FontWeight="SemiBold" 
                        Foreground="White" 
                        FontFamily="Roboto" />
                    <TextBlock x:Name="StatusTextBlock" 
                        Text="PENDING" 
                        FontSize="40" 
                        FontWeight="SemiBold"
                        Foreground="#FF8800" 
                        FontFamily="Roboto" />
                </StackPanel>

                <!-- Browse Button -->
                <Button HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,60,0"
                        Click="BrowseButton_Click">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Image Source="pack://application:,,,/Window_Event_Log;component/Assets/Browse_B.png" Width="150" Height="50" Stretch="Uniform" />
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </Grid>

            <!-- Save and Export Buttons -->
            <Grid HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,720,0,0">
                <Image Source="pack://application:,,,/Window_Event_Log;component/Assets/Background_B.png"
                    Width="960" Height="320" />

                <!-- Save Button -->
                <Button Width="400" Height="230" Margin="0,0,450,0"
                        Click="SaveButton_Click">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Image Source="pack://application:,,,/Window_Event_Log;component/Assets/Save_B.png" Stretch="Uniform" />
                        </ControlTemplate>
                    </Button.Template>
                </Button>

                <!-- Export Button -->
                <Button Width="400" Height="230" Margin="450,0,0,0"
                        Click="ExportButton_Click">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Image Source="pack://application:,,,/Window_Event_Log;component/Assets/Export_B.png" Stretch="Uniform" />
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </Grid>

            <!-- Back Button -->
            <Grid x:Name="BackButtonGrid" Width="600" Height="112" 
                  HorizontalAlignment="Center" 
                  VerticalAlignment="Bottom" 
                  Margin="0,0,0,50">
                <Button Click="BackButton_Click">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Grid>
                                <Image Source="pack://application:,,,/Window_Event_Log;component/Assets/LongButton.png" Stretch="Uniform" />
                                <TextBlock Text="BACK" 
                                    FontSize="40" 
                                    FontWeight="Bold"
                                    FontFamily="Roboto"
                                    Foreground="#FFFFFF"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"/>
                            </Grid>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </Grid>
        </Grid>
    </Viewbox>
</UserControl>