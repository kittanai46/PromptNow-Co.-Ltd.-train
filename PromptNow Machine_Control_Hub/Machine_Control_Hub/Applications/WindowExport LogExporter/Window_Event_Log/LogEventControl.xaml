<UserControl x:Class="Window_Event_Log.LogEventControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="#FFFFFFFF">
    <Viewbox>
        <Grid Height="1440" Width="1080">
            <!-- Background -->
            <Grid.Background>
                <ImageBrush ImageSource="pack://application:,,,/Assets/Wallpaper.png" Stretch="UniformToFill" />
            </Grid.Background>

            <!-- Date and Time -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="40,75,0,0">
                <TextBlock x:Name="DateText" FontSize="20" FontWeight="Bold" Foreground="#CACACA" FontFamily="Roboto" />
                <TextBlock Text=" " FontSize="20" Width="45" />
                <TextBlock x:Name="TimeText" FontSize="20" FontWeight="Medium" Foreground="#CACACA" FontFamily="Noto Sans" Margin="0,-5,0,0"/>
            </StackPanel>

            <!-- Version Information -->
            <StackPanel HorizontalAlignment="Right" >
                <TextBlock Text="Launcher Version : 1.2.26.1333" 
                   FontSize="20" 
                   FontWeight="Medium" 
                   Foreground="#CACACA" 
                   FontFamily="Noto Sans" 
                   HorizontalAlignment="Right"
                   Margin="0,40,30,0"/>
                <TextBlock Text="PromptConnect : 1.2.10.240" 
                   FontSize="20" 
                   FontWeight="Medium" 
                   Foreground="#CACACA" 
                   FontFamily="Noto Sans" 
                   HorizontalAlignment="Right"
                   Margin="0,0,30,0"/>
                <TextBlock Text="MAC Address : 12as1234dfg1" 
                    FontSize="20" 
                    FontWeight="Medium" 
                    Foreground="#CACACA" 
                    FontFamily="Noto Sans" 
                    HorizontalAlignment="Right"
                    Margin="0,0,30,0"/>
            </StackPanel>

            <!-- Title -->
            <TextBlock Text="Windows Event Log Exporter"
               FontSize="36"
               FontFamily="Noto Sans"
               Foreground="#CACACA"
               HorizontalAlignment="Center"
               Margin="0,200,0,0"/>
            <TextBlock Text="Choose Log Type"
               FontSize="48"
               FontWeight="Bold"
               FontFamily="Noto Sans"
               Foreground="#FFFFFF"
               HorizontalAlignment="Center"
               Margin="0,245,0,0"/>

            <!-- Background Log -->
            <Grid HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,80,0,0">
                <Image Source="pack://application:,,,/Window_Event_Log;component/Assets/Background_Log.png"
                       Width="960" Height="820" />
                <!-- Button Log -->

                <!-- Application -->
                <Button Width="410" Height="175" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="50,160,0,0"
                    Click="ApplicationLog_Click" BorderThickness="0" Background="Transparent">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Image Source="pack://application:,,,/Window_Event_Log;component/Assets/Application_B.png" Stretch="Uniform" />
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Opacity" Value="1"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>

                <!-- System -->
                <Button Width="410" Height="175" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,160,50,0"
                    Click="SystemLog_Click" BorderThickness="0" Background="Transparent">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Image Source="pack://application:,,,/Window_Event_Log;component/Assets/System_B.png" Stretch="Uniform" />
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Opacity" Value="1"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>

                <!-- Security -->
                <Button Width="410" Height="175" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="50,360,50,0"
                    Click="SecurityLog_Click" BorderThickness="0" Background="Transparent">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Image Source="pack://application:,,,/Window_Event_Log;component/Assets/Security_B.png" Stretch="Uniform" />
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Opacity" Value="1"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>

                <!-- Setup -->
                <Button Width="410" Height="175" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,360,50,0"
                    Click="SetupLog_Click" BorderThickness="0" Background="Transparent">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Image Source="pack://application:,,,/Window_Event_Log;component/Assets/Setup_B.png" Stretch="Uniform" />
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Opacity" Value="1"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>

                <!-- Forwarded-->
                <Button Width="410" Height="175" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="50,570,50,0"
                    Click="ForwardedEventsLog_Click" BorderThickness="0" Background="Transparent">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Image Source="pack://application:,,,/Window_Event_Log;component/Assets/Forwarded Events_B.png" Stretch="Uniform" />
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Opacity" Value="1"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>

                <!-- Void-->
                <Button Width="410" Height="175" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,570,50,0"
        BorderThickness="0" Background="Transparent">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Image Source="pack://application:,,,/Window_Event_Log;component/Assets/Void_B.png" Stretch="Uniform" />
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Opacity" Value="1"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>

            </Grid>

            <!-- Button -->
            <Grid x:Name="BackButtonGrid" Width="600" Height="112" 
                  HorizontalAlignment="Center" 
                  VerticalAlignment="Bottom" 
                  Margin="0,0,0,50">
                <Button Click="BackButton_Click" 
                        BorderThickness="0" 
                        Background="Transparent">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Grid>
                                <Image Source="pack://application:,,,/Assets/LongButton.png" Stretch="Uniform" />
                                <TextBlock Text="BACK" 
                             FontSize="40" 
                             FontWeight="Bold"
                             FontFamily="Roboto"
                             Foreground="#FFFFFF"
                             HorizontalAlignment="Center"
                             VerticalAlignment="Center"/>
                            </Grid>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </Grid>
        </Grid>
    </Viewbox>
</UserControl>
