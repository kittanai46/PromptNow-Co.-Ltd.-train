<UserControl x:Class="NetworkAdapter.NetworkAdapterControl"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Background="#FFFFFFFF">
    <Viewbox>
        <Grid Height="1440" Width="1080">
            <!-- Background -->
            <Grid.Background>
                <ImageBrush ImageSource="pack://application:,,,/Assets/Wallpaper.png" Stretch="UniformToFill" />
            </Grid.Background>

            <!-- Date and Time -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Margin="40,75,0,0">
                <TextBlock x:Name="DateText" FontSize="20" FontWeight="Bold" Foreground="#CACACA" FontFamily="Roboto" />
                <TextBlock FontSize="20" Width="45" />
                <TextBlock x:Name="TimeText" FontSize="20" FontWeight="Medium" Foreground="#CACACA" FontFamily="Noto Sans" Margin="0,-5,0,0" />
            </StackPanel>

            <!-- Version Information -->
            <StackPanel HorizontalAlignment="Right" >
                <TextBlock Text="Launcher Version : 1.2.26.1333" 
                        FontSize="20" 
                        FontWeight="Medium" 
                        Foreground="#CACACA" 
                        FontFamily="Noto Sans" 
                        HorizontalAlignment="Right"
                        Margin="0,40,30,0"/>
                <TextBlock Text="PromptConnect : 1.2.10.240" 
                        FontSize="20" 
                        FontWeight="Medium" 
                        Foreground="#CACACA" 
                        FontFamily="Noto Sans" 
                        HorizontalAlignment="Right"
                        Margin="0,0,30,0"/>
                <TextBlock Text="MAC Address : 12as1234dfg1" 
                         FontSize="20" 
                         FontWeight="Medium" 
                         Foreground="#CACACA" 
                         FontFamily="Noto Sans" 
                         HorizontalAlignment="Right"
                         Margin="0,0,30,0"/>
            </StackPanel>

            <!-- Title -->
            <TextBlock Text="Network Adapter Configuration"
                        FontSize="36"
                        FontFamily="Noto Sans"
                        Foreground="#CACACA"
                        HorizontalAlignment="Center"
                        Margin="0,200,0,0"/>
            <TextBlock Text="Select Network Adapter"
                       FontSize="48"
                       FontWeight="Bold"
                       FontFamily="Noto Sans"
                       Foreground="#FFFFFF"
                       HorizontalAlignment="Center"
                       Margin="0,245,0,0"/>

            <!-- Adapter List -->
            <ScrollViewer VerticalScrollBarVisibility="Hidden" PanningMode="VerticalOnly"
                          Margin="0,70,0,100"  Width="960" Height="700">
                <ItemsControl x:Name="AdapterGrid" HorizontalAlignment="Center" VerticalAlignment="Top"
                              Margin="0,50,0,50">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal" HorizontalAlignment="Center"
                                       ItemWidth="400" ItemHeight="300" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Background="Transparent" BorderThickness="0" Padding="0">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border Width="360" Height="266" CornerRadius="20">
                                            <Border.Background>
                                                <ImageBrush ImageSource="pack://application:,,,/Static IP Application;component/Assets/Select.png" 
                                                          Stretch="UniformToFill"/>
                                            </Border.Background>
                                            <Grid>
                                                <TextBlock Text="{Binding}" 
                                                         VerticalAlignment="Center" 
                                                         HorizontalAlignment="Center"
                                                         Foreground="White"
                                                         FontSize="40"
                                                         FontWeight="Bold"
                                                         FontFamily="Noto Sans"
                                                         TextWrapping="Wrap"
                                                         TextAlignment="Center"/>
                                            </Grid>
                                        </Border>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <!-- Back Button -->
            <Grid x:Name="BACK" Width="600" Height="112" 
                  HorizontalAlignment="Center" 
                  VerticalAlignment="Bottom" 
                  Margin="0,0,0,50">
                <Button Click="BackButton_Click">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Grid>
                                <Image Source="pack://application:,,,/Assets/LongButton.png" Stretch="Uniform" />
                                <TextBlock Text="BACK" 
                                          FontSize="40" 
                                          FontWeight="Bold"
                                          FontFamily="Roboto"
                                          Foreground="#FFFFFF"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center"/>
                            </Grid>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </Grid>
        </Grid>
    </Viewbox>
</UserControl>