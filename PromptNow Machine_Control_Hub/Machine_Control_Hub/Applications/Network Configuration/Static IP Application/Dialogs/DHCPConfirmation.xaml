<Window x:Class="WpfStaticIPApp.DHCPConfirmation"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DHCP Confirmation" Height="720" Width="540"
        WindowStartupLocation="CenterScreen" Background="#FFFFFF">
    <Viewbox>
        <Grid Height="1440" Width="1080">
            <!-- Background Image -->
            <Grid.Background>
                <ImageBrush ImageSource="pack://application:,,,/Assets/Wallpaper.png"
                            Stretch="UniformToFill" />
            </Grid.Background>

            <!-- Date and Time -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Margin="40,75,0,0" Grid.RowSpan="2">
                <TextBlock x:Name="DateText" FontSize="20" FontWeight="Bold" Foreground="#CACACA" FontFamily="Roboto" />
                <TextBlock FontSize="20" Width="45" />
                <TextBlock x:Name="TimeText" FontSize="20" FontWeight="Medium" Foreground="#CACACA" FontFamily="Noto Sans" Margin="0,-5,0,0" />
            </StackPanel>

            <!-- Version Information -->
            <StackPanel HorizontalAlignment="Right" Grid.RowSpan="2" >
                <TextBlock Text="Launcher Version : 1.2.26.1333" 
                        FontSize="20" 
                        FontWeight="Medium" 
                        Foreground="#CACACA" 
                        FontFamily="Noto Sans" 
                        HorizontalAlignment="Right"
                        Margin="0,40,30,0"/>
                <TextBlock Text="PromptConnect : 1.2.10.240" 
                        FontSize="20" 
                        FontWeight="Medium" 
                        Foreground="#CACACA" 
                        FontFamily="Noto Sans" 
                        HorizontalAlignment="Right"
                        Margin="0,0,30,0"/>
                <TextBlock Text="MAC Address : 12as1234dfg1" 
                         FontSize="20" 
                         FontWeight="Medium" 
                         Foreground="#CACACA" 
                         FontFamily="Noto Sans" 
                         HorizontalAlignment="Right"
                         Margin="0,0,30,0"/>
            </StackPanel>

            <!-- Warning Background -->
            <Image Source="pack://application:,,,/Static IP Application;component/Assets/Warning message.png" Width="1020" Height="1050"
       HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,150,0,0" Grid.RowSpan="2" />

            <!-- Warning_Sign -->
            <Image Source="pack://application:,,,/Static IP Application;component/Assets/Warning_Sign.png" Width="128" Height="128"
       HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,520,0,0" />

            <!-- Warning Text-->
           
                <TextBlock Text="Are you sure you want to enable DHCP " 
                FontSize="36" 
                FontWeight="Medium" 
                Foreground="#FFD600" 
                FontFamily="Noto Sans" 
                HorizontalAlignment="Center"
                Margin="0,700,0,0"/>
            
                <TextBlock Text="and reset network settings to automatic ?" 
                FontSize="36" 
                FontWeight="Medium" 
                Foreground="#FFD600" 
                FontFamily="Noto Sans" 
                HorizontalAlignment="Center"
                Margin="0,740,0,0"/>
                


            <!-- YES Button -->
            <Grid x:Name="YES" Width="300" Height="112" 
                HorizontalAlignment="Left" VerticalAlignment="Bottom" 
                 Margin="220,0,0,50" Grid.Row="1">
                <Button  Click="YESButton_Click"
                    BorderThickness="0" 
                    Background="Transparent">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Grid>
                                <Image Source="pack://application:,,,/Static IP Application;component/Assets/Red_Button.png" Stretch="Uniform" />
                                <TextBlock Text="YES" 
                             FontSize="40" 
                             FontWeight="Bold"
                             FontFamily="Roboto"
                             Foreground="#FFFFFF"
                             HorizontalAlignment="Center"
                             VerticalAlignment="Center"/>
                            </Grid>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </Grid>

            <!-- Cancel Button -->
            <Grid x:Name="CANCEL" Width="300" Height="112" 
                HorizontalAlignment="Left" VerticalAlignment="Bottom" 
                  Margin="560,0,0,50" Grid.Row="1">
                <Button   Click="CancelButton_Click"
                    BorderThickness="0" 
                    Background="Transparent">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Grid>
                                <Image Source="pack://application:,,,/Static IP Application;component/Assets/Green_Button.png" Stretch="Uniform" />
                                <TextBlock Text="CANCEL" 
                             FontSize="40" 
                             FontWeight="Bold"
                             FontFamily="Roboto"
                             Foreground="#FFFFFF"
                             HorizontalAlignment="Center"
                             VerticalAlignment="Center"/>
                            </Grid>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </Grid>


        </Grid>
    </Viewbox>
</Window>
