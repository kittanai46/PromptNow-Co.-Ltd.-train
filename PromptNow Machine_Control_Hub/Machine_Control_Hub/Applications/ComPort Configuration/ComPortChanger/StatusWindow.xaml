<Window x:Class="ComPortChanger.StatusWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="COM Port Status" Height="720" Width="540"
        Background="#FFFFFFFF">
    <Viewbox>
        <Grid Height="1440" Width="1080">
            <!-- Background -->
            <Grid.Background>
                <ImageBrush ImageSource="pack://application:,,,/Assets/Wallpaper.png" Stretch="UniformToFill" />
            </Grid.Background>

            <!-- Header Content -->
            <StackPanel>
                <!-- Date and Time -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Margin="40,75,0,0">
                    <TextBlock x:Name="DateText" FontSize="20" FontWeight="Bold" Foreground="#CACACA" FontFamily="Roboto" />
                    <TextBlock FontSize="20" Width="45" />
                    <TextBlock x:Name="TimeText" FontSize="20" FontWeight="Medium" Foreground="#CACACA" FontFamily="Noto Sans" Margin="0,-5,0,0" />
                </StackPanel>
            </StackPanel>

            <!-- Version Information -->
            <StackPanel HorizontalAlignment="Right" >
                <TextBlock Text="Launcher Version : 1.2.26.1333" 
                   FontSize="20" 
                   FontWeight="Medium" 
                   Foreground="#CACACA" 
                   FontFamily="Noto Sans" 
                   HorizontalAlignment="Right"
                   Margin="0,40,30,0"/>
                <TextBlock Text="PromptConnect : 1.2.10.240" 
                   FontSize="20" 
                   FontWeight="Medium" 
                   Foreground="#CACACA" 
                   FontFamily="Noto Sans" 
                   HorizontalAlignment="Right"
                   Margin="0,0,30,0"/>
                <TextBlock Text="MAC Address : 12as1234dfg1" 
                    FontSize="20" 
                    FontWeight="Medium" 
                    Foreground="#CACACA" 
                    FontFamily="Noto Sans" 
                    HorizontalAlignment="Right"
                    Margin="0,0,30,0"/>
            </StackPanel>

            <!-- Title -->
            <TextBlock Text="COM Port Configuration Manager"
               FontSize="36"
               FontFamily="Noto Sans"
               Foreground="#CACACA"
               HorizontalAlignment="Center"
               Margin="0,200,0,0"/>
            <TextBlock Text="COM Port Configuration Status"
               FontSize="48"
               FontWeight="Bold"
               FontFamily="Noto Sans"
               Foreground="#FFFFFF"
               HorizontalAlignment="Center"
               Margin="0,245,0,0"/>


            <!-- Box_Frame Background -->
            <Grid x:Name="FrameContainer" Width="960" Height="750"
                  HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,370,0,0">
            </Grid>

            <!-- Scrollable Port Names -->
            <ScrollViewer VerticalScrollBarVisibility="Hidden"
                         HorizontalScrollBarVisibility="Disabled"
                         Width="900"
                         Height="500"
                         Margin="0,120,0,0">
                <StackPanel x:Name="PortNamesContainer" 
                          HorizontalAlignment="Left">
                    <!-- Port names will be added here -->
                </StackPanel>
            </ScrollViewer>

            <!-- Status Text -->
            <StackPanel Orientation="Horizontal"
            HorizontalAlignment="Left"
            VerticalAlignment="Top"
            Margin="120,1120,0,0">
                <TextBlock Text="STATUS: "
               FontSize="36"
               FontFamily="Noto Sans"
               Foreground="#FFFFFF"/>
                <TextBlock x:Name="StatusText"
               FontSize="36"
               FontFamily="Noto Sans"
               Margin="10,0,0,0"/>
            </StackPanel>

            <!-- Button -->
            <Grid x:Name="OkButtonGrid" Width="600" Height="112" 
                  HorizontalAlignment="Center" 
                  VerticalAlignment="Bottom" 
                  Margin="0,0,0,50">
                <Button Click="Ok_Click" 
                        BorderThickness="0" 
                        Background="Transparent">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Grid>
                             <Image Source="pack://application:,,,/Assets/LongButton.png" Stretch="Uniform" />
                            <TextBlock Text="OK" 
                             FontSize="40" 
                             FontWeight="Bold"
                             FontFamily="Roboto"
                             Foreground="#FFFFFF"
                             HorizontalAlignment="Center"
                             VerticalAlignment="Center"/>
                            </Grid>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </Grid>
        </Grid>
    </Viewbox>
</Window>