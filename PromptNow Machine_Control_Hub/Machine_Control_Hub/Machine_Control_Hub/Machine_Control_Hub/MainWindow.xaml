<Window x:Class="Machine_Control_Hub.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Machine_Control_Hub"
        mc:Ignorable="d"
        Title="MainWindow"  Height="720" Width="540"
        Background="#FFFFFFFF">
    <Viewbox>
        <Grid Height="1440" Width="1080">
            <!-- Background -->
            <Grid.Background>
                <ImageBrush ImageSource="pack://application:,,,/Assets/Wallpaper.png" Stretch="UniformToFill" />
            </Grid.Background>
            <Grid>

                <!-- Header Content -->
                <StackPanel>
                    <!-- Date and Time -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Margin="40,75,0,0">
                        <TextBlock x:Name="DateText" FontSize="20" FontWeight="Bold" Foreground="#CACACA" FontFamily="Roboto" />
                        <TextBlock FontSize="20" Width="45" />
                        <TextBlock x:Name="TimeText" FontSize="20" FontWeight="Medium" Foreground="#CACACA" FontFamily="Noto Sans" Margin="0,-5,0,0" />
                    </StackPanel>
                </StackPanel>


                <!-- Version Information -->
                <StackPanel HorizontalAlignment="Right" >
                    <TextBlock Text="Launcher Version : 1.2.26.1333" 
                   FontSize="20" 
                   FontWeight="Medium" 
                   Foreground="#CACACA" 
                   FontFamily="Noto Sans" 
                   HorizontalAlignment="Right"
                   Margin="0,40,30,0"/>
                    <TextBlock Text="PromptConnect : 1.2.10.240" 
                   FontSize="20" 
                   FontWeight="Medium" 
                   Foreground="#CACACA" 
                   FontFamily="Noto Sans" 
                   HorizontalAlignment="Right"
                   Margin="0,0,30,0"/>
                    <TextBlock Text="MAC Address : 12as1234dfg1" 
                    FontSize="20" 
                    FontWeight="Medium" 
                    Foreground="#CACACA" 
                    FontFamily="Noto Sans" 
                    HorizontalAlignment="Right"
                    Margin="0,0,30,0"/>
                </StackPanel>

                <!-- Title -->
                <TextBlock Text="Automation Control Center"
                           FontSize="36"
                           FontFamily="Noto Sans"
                           Foreground="#CACACA"
                           HorizontalAlignment="Center"
                           Margin="0,200,0,0"/>
                <TextBlock Text="Machine Control Hub"
                           FontSize="48"
                           FontWeight="Bold"
                           FontFamily="Noto Sans"
                           Foreground="#FFFFFF"
                           HorizontalAlignment="Center"
                           Margin="0,245,0,0"/>

                <!-- NetConfig  -->
                <Grid x:Name="NetConfig" Width="420" Height="320" 
                        HorizontalAlignment="Center" VerticalAlignment="Center" 
                        Margin="0,0,450,350">
                    <Button Click="NetConfig_Click" 
                            BorderThickness="0" 
                            Background="Transparent"> 
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Grid>
                                    <Image Source="pack://application:,,,/Assets/Icon1.png" Stretch="Uniform" />
                                    <TextBlock Text="Network Adapter" 
                                               FontSize="40" 
                                               FontWeight="Bold"
                                               FontFamily="Roboto"
                                               Foreground="#FFFFFF"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               Margin="0,0,0,80"/>
                                    <TextBlock Text="Configuration" 
                                               FontSize="40" 
                                               FontWeight="Bold"
                                               FontFamily="Roboto"
                                               Foreground="#FFFFFF"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               Margin="0,50,0,0"/>
                                </Grid>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </Grid>

                <!-- ExportLog  -->
                <Grid x:Name="LogExport" Width="420" Height="320" 
                        HorizontalAlignment="Center" VerticalAlignment="Center" 
                        Margin="450,0,0,350">
                    <Button Click="LogExport_Click" 
                            BorderThickness="0" 
                            Background="Transparent">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Grid>
                                    <Image Source="pack://application:,,,/Assets/Icon4.png" Stretch="Uniform" />
                                    <TextBlock Text="Windows Event" 
                                               FontSize="40" 
                                               FontWeight="Bold"
                                               FontFamily="Roboto"
                                               Foreground="#FFFFFF"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               Margin="0,0,0,80"/>
                                    <TextBlock Text="Log Exporter" 
                                               FontSize="40" 
                                               FontWeight="Bold"
                                               FontFamily="Roboto"
                                               Foreground="#FFFFFF"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               Margin="0,50,0,0"/>
                                </Grid>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </Grid>

                <!-- Com Port Chang-->
                <Grid x:Name="ComPortChang" Width="420" Height="320" 
                          HorizontalAlignment="Center" VerticalAlignment="Center" 
                          Margin="0,350,450,0">
                    <Button Click="ComPortChang_Click" 
                              BorderThickness="0" 
                              Background="Transparent">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Grid>
                                    <Image Source="pack://application:,,,/Assets/Icon2.png" Stretch="Uniform" /> 
                                    <TextBlock Text="COM Port" 
                                                FontSize="40" 
                                                FontWeight="Bold"
                                                FontFamily="Roboto"
                                                Foreground="#FFFFFF"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                Margin="0,0,0,80"/>
                                    <TextBlock Text="Configuration" 
                                                FontSize="40" 
                                                FontWeight="Bold"
                                                FontFamily="Roboto"
                                                Foreground="#FFFFFF"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                Margin="0,50,0,0"/>
                                </Grid>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </Grid>

                <!-- Void_Icon-->
                <Grid x:Name="Void_Icon" Width="420" Height="320" 
                          HorizontalAlignment="Center" VerticalAlignment="Center" 
                          Margin="450,350,0,0">
                    <Button Click="Void_Icon_Click" 
                              BorderThickness="0" 
                              Background="Transparent">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Grid>
                                    <Image Source="pack://application:,,,/Assets/Void_Icon.png" Stretch="Uniform" />
                                </Grid>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </Grid>





                <!-- Button -->
                <Grid x:Name="BackButton" Width="600" Height="112" 
                       HorizontalAlignment="Center" 
                       VerticalAlignment="Bottom" 
                       Margin="0,0,0,50">
                    <Button Click="BackButton_Click" 
                             BorderThickness="0" 
                             Background="Transparent">  
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Grid>
                                    <Image Source="pack://application:,,,/Assets/LongButton.png" Stretch="Uniform" />
                                    <TextBlock Text="BACK" 
                                              FontSize="40" 
                                              FontWeight="Bold"
                                              FontFamily="Roboto"
                                              Foreground="#FFFFFF"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                                </Grid>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </Grid>

            </Grid>
        </Grid>
    </Viewbox>
</Window>
